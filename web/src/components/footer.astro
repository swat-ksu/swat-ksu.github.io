---
import { Image } from "astro/components/Image.astro";
import Github from "..assests/images/GitHub_Lockup_White.png"
---

<footer>
    <a href="" target="_blank" rel="noopener noreferrer">
        <Image src={Github} alt="Github Logo" decoding="async" loading="lazy"/>
    </a>
</footer>
<style>
    footer {
        min-height: 5dvh;
        background-color: #121315;
        display: flex;
    }
</style>